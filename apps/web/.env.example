# Copy to .env.local. VITE_* vars are baked into the browser bundle, never put secrets here.
# Same URL `convex dev` writes to packages/backend/.env.local (local: http://127.0.0.1:3210).
VITE_CONVEX_URL=

# Clerk publishable key. Create a JWT template named "convex" in Clerk.
VITE_CLERK_PUBLISHABLE_KEY=
