# Copy to .env.local and fill in. `bunx convex dev` writes VITE_CONVEX_URL for you.
VITE_CONVEX_URL=

# Auth (Clerk). Get the key from your Clerk dashboard, then create a JWT
# template named "convex". The backend also needs CLERK_JWT_ISSUER_DOMAIN
# visible to the `bunx convex dev` process (see convex/auth.config.ts).
VITE_CLERK_PUBLISHABLE_KEY=
